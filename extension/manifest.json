{
  "manifest_version": 3,
  "name": "InHubFlow Connect",
  "version": "1.2.0",
  "description": "Extensión complementaria oficial para sincronizar tu cuenta profesional y ejecutar tareas en segundo plano con InHubFlow.",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "https://*.inhubflow.online/*",
    "http://localhost:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "https://*.inhubflow.online/*",
        "http://localhost:*/*"
      ],
      "js": ["content-runner.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "InHubFlow Connect",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
